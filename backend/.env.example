# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tech_flow?schema=public"

# JWT secret - change this to a long random string in production
JWT_SECRET="replace_this_with_a_long_random_secret_key"

# Token expiry (e.g. 7d, 12h, 1h)
JWT_EXPIRES_IN="7d"

# Server port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:3000"
